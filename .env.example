APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=livora-api
JWT_AUDIENCE=livora-mobile

# Comma-separated browser origins. Native mobile clients do not use CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ENFORCE_HTTPS=0
TRUST_PROXY=0
MAX_UPLOAD_BYTES=20971520
MAX_BATCH_FILES=6

# Private Cloudflare R2 storage for original uploaded reports.
R2_BUCKET=livora-private-reports
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
REPORT_VIEW_URL_TTL_SECONDS=300

# Optional executable locations. Leave blank when the tools are on PATH.
# Windows examples:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin
TESSERACT_CMD=
POPPLER_PATH=

FIREWORKS_API_KEY=replace-me
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
